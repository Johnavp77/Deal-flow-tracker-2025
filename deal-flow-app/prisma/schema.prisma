generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model Organization {
  id    String  @id @default(uuid())
  name  String
  users User[]
  clients Client[]
  properties Property[]
  deals Deal[]
}
enum Role { admin manager broker analyst client }
model User {
  id        String   @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  fullName  String
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
  deals     Deal[]   @relation("DealOwner")
  activities ActivityLog[]
}
model Client {
  id        String   @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  name      String
  sector    String?
  headcount Int?
  hqCity    String?
  deals     Deal[]
}
enum Stage { lead discovery sourcing shortlist tour_planning touring loi negotiation legal won lost }
model Deal {
  id        String   @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  client    Client   @relation(fields: [clientId], references: [id])
  clientId  String
  owner     User     @relation("DealOwner", fields: [ownerId], references: [id])
  ownerId   String
  title     String
  stage     Stage
  probability Decimal? @db.Decimal(3,2)
  expectedMoveIn DateTime?
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requirements DealRequirements?
  shortlists Shortlist[]
  tours     Tour[]
  lois      LOI[]
  activities ActivityLog[]
}
model DealRequirements {
  id        String @id @default(uuid())
  deal      Deal   @relation(fields: [dealId], references: [id])
  dealId    String
  rsfMin    Int?
  rsfMax    Int?
  termMonths Int?
  leaseType String?
  submarkets String[]
  budgetPsf Decimal? @db.Decimal(10,2)
  ceilingHeightFt Decimal? @db.Decimal(10,2)
  baySpacingFt Decimal? @db.Decimal(10,2)
  labType   String?
  powerKva  Decimal? @db.Decimal(10,2)
  parkingRatio Decimal? @db.Decimal(10,2)
  notes     String?
}
enum PropertyType { Office Industrial Flex Lab Medical Retail }
enum BuildingClass { A B C }
model Property {
  id        String @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  address1  String?
  city      String?
  state     String?
  postalCode String?
  lat       Decimal? @db.Decimal(12,8)
  lng       Decimal? @db.Decimal(12,8)
  submarket String?
  propertyType PropertyType?
  buildingClass BuildingClass?
  rsfTotal  Int?
  ownerName String?
  landlordRepContactId String?
  sourceUrl String?
  availabilities Availability[]
  comps     Comp[]
}
model Availability {
  id        String @id @default(uuid())
  property  Property @relation(fields: [propertyId], references: [id])
  propertyId String
  suite     String?
  rsf       Int?
  floor     String?
  condition String?
  deliveryDate DateTime?
  askingRentPsf Decimal? @db.Decimal(10,2)
  leaseType String?
  opExPsf   Decimal? @db.Decimal(10,2)
  baseYear  Int?
  nnnPsf    Decimal? @db.Decimal(10,2)
  tiPsf     Decimal? @db.Decimal(10,2)
  freeRentMonths Int?
  escalationPct Decimal? @db.Decimal(5,2)
  termMin   Int?
  termMax   Int?
  shortlistItems ShortlistItem[]
  tourStops TourStop[]
}
model Shortlist {
  id        String @id @default(uuid())
  deal      Deal   @relation(fields: [dealId], references: [id])
  dealId    String
  name      String @default("Shortlist")
  items     ShortlistItem[]
}
model ShortlistItem {
  id        String @id @default(uuid())
  shortlist Shortlist @relation(fields: [shortlistId], references: [id])
  shortlistId String
  property  Property @relation(fields: [propertyId], references: [id])
  propertyId String
  availability Availability? @relation(fields: [availabilityId], references: [id])
  availabilityId String?
  score     Decimal? @db.Decimal(5,2)
  status    String?
  brokerNotes String?
  feedbacks Feedback[]
}
model Tour {
  id        String @id @default(uuid())
  deal      Deal   @relation(fields: [dealId], references: [id])
  dealId    String
  tourDate  DateTime?
  notes     String?
  stops     TourStop[]
}
model TourStop {
  id        String @id @default(uuid())
  tour      Tour   @relation(fields: [tourId], references: [id])
  tourId    String
  property  Property @relation(fields: [propertyId], references: [id])
  propertyId String
  availability Availability? @relation(fields: [availabilityId], references: [id])
  availabilityId String?
  stopOrder Int?
  feedbacks Feedback[]
}
model Feedback {
  id        String @id @default(uuid())
  tourStop  TourStop? @relation(fields: [tourStopId], references: [id])
  tourStopId String?
  shortlistItem ShortlistItem? @relation(fields: [shortlistItemId], references: [id])
  shortlistItemId String?
  byUser    User?    @relation(fields: [byUserId], references: [id])
  byUserId  String?
  rating    Int?
  fitNotes  String?
  concerns  String?
  willPursue Boolean?
}
enum LOIStatus { Draft Sent Countered Agreed }
model LOI {
  id        String @id @default(uuid())
  deal      Deal   @relation(fields: [dealId], references: [id])
  dealId    String
  version   Int     @default(1)
  status    LOIStatus
  pdfUrl    String?
  terms     LOITerm[]
}
model LOITerm {
  id        String @id @default(uuid())
  loi       LOI    @relation(fields: [loiId], references: [id])
  loiId     String
  fieldName String
  value     String?
  unit      String?
}
enum CompType { Lease Sale }
model Comp {
  id        String @id @default(uuid())
  property  Property? @relation(fields: [propertyId], references: [id])
  propertyId String?
  compType  CompType
  rsf       Int?
  rentPsfStart Decimal? @db.Decimal(10,2)
  escalationPct Decimal? @db.Decimal(5,2)
  tiPsf     Decimal? @db.Decimal(10,2)
  freeRentMonths Int?
  compDate  DateTime?
  sourceUrl String?
}
model Document {
  id        String @id @default(uuid())
  entityType String
  entityId  String
  fileUrl   String
  version   Int @default(1)
  kind      String?
  uploadedBy String?
  createdAt DateTime @default(now())
}
model Task {
  id        String @id @default(uuid())
  entityType String
  entityId  String
  title     String
  dueDate   DateTime?
  assignedTo String?
  status    String @default("Open")
}
model ActivityLog {
  id        String @id @default(uuid())
  user      User? @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  entityType String
  entityId  String
  diffJson  Json?
  createdAt DateTime @default(now())
}
